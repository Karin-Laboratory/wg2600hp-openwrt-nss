From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ButlerX <butlerx@localhost>
Date: Mon, 5 Oct 2026 14:40:00 +0900
Subject: [PATCH] qca-nss-ecm: finish Linux 6.12 prototype compatibility

Use current upstream TCP liberal-policy fields for IPv6 as for IPv4 and
declare the existing NSS callbacks and mark classifier lifecycle functions.

--- a/frontends/nss/ecm_nss_ported_ipv6.c
+++ b/frontends/nss/ecm_nss_ported_ipv6.c
@@ -1143,5 +1143,5 @@
 #ifdef ECM_OPENWRT_SUPPORT
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 12, 0))
-			if (tn->tcp_be_liberal || tn->tcp_no_window_check
+			if (tn->tcp_be_liberal
 #else
 			if (tn->tcp_be_liberal || nf_ct_tcp_no_window_check
--- a/frontends/nss/ecm_nss_ported_ipv6.h
+++ b/frontends/nss/ecm_nss_ported_ipv6.h
@@ -25,2 +25,4 @@
 								int protocol,
 								struct ecm_db_connection_instance **nci);
+
+extern bool ecm_nss_ported_ipv6_connection_defunct_callback(void *arg, int *accel_mode);
--- a/ecm_classifier_mark.h
+++ b/ecm_classifier_mark.h
@@ -19,1 +19,3 @@
 struct ecm_classifier_mark_instance *ecm_classifier_mark_instance_alloc(struct ecm_db_connection_instance *ci);
+extern int ecm_classifier_mark_init(struct dentry *dentry);
+extern void ecm_classifier_mark_exit(void);
-- 
2.43.0
