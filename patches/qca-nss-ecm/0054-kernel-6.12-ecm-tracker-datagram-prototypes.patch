From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ButlerX <butlerx@localhost>
Date: Mon, 5 Oct 2026 17:35:00 +0900
Subject: [PATCH] qca-nss-ecm: declare exported datagram tracker helpers

These helpers are exported by the legacy ECM module interface.  Declare them
in the tracker header so strict Linux 6.12 prototype checking sees the same
external API as the EXPORT_SYMBOL declarations.

--- a/ecm_tracker_datagram.h
+++ b/ecm_tracker_datagram.h
@@ -22,1 +22,10 @@
 struct ecm_tracker_datagram_instance *ecm_tracker_datagram_alloc(void);
+
+struct ecm_tracker_datagram_internal_instance;
+void ecm_tracker_datagram_discard_all(struct ecm_tracker_datagram_internal_instance *dtii);
+int32_t ecm_tracker_datagram_datagram_size_get(struct ecm_tracker_datagram_instance *uti,
+		ecm_tracker_sender_type_t sender, int32_t i);
+int ecm_tracker_datagram_datagram_read(struct ecm_tracker_datagram_instance *uti,
+		ecm_tracker_sender_type_t sender, int32_t i, int32_t offset, int32_t size, void *buffer);
+bool ecm_tracker_datagram_datagram_add(struct ecm_tracker_datagram_instance *uti,
+		ecm_tracker_sender_type_t sender, struct sk_buff *skb);
-- 
2.43.0
