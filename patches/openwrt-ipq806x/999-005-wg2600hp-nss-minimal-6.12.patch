From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ipq8064: wg2600hp: add NSS cores and NSS GMAC binding

Keep the OpenWrt 25.12.5 WG2600HP DSA topology and only add the
IPQ806x NSS resources required by the existing qca-nss modules.

--- a/arch/arm/boot/dts/qcom/qcom-ipq8064.dtsi
+++ b/arch/arm/boot/dts/qcom/qcom-ipq8064.dtsi
@@ -743,4 +743,61 @@
 		nss_common: syscon@3000000 {
-			compatible = "syscon";
+			compatible = "qcom,nss-common", "syscon";
 			reg = <0x03000000 0x0000FFFF>;
+			clocks = <&gcc UBI32_CORE1_CLK>, <&gcc NSSTCM_CLK>,
+				<&rpmcc RPM_NSS_FABRIC_0_CLK>, <&rpmcc RPM_NSS_FABRIC_1_CLK>;
+			clock-names = "nss_core_clk", "nss_tcm_clk",
+				"nss-fab0-clk", "nss-fab1-clk";
+		};
+
+		nss0: nss@40000000 {
+			compatible = "qcom,nss";
+			qcom,low-frequency = <733000000>;
+			qcom,mid-frequency = <733000000>;
+			qcom,max-frequency = <733000000>;
+			interrupts = <GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 232 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0x36000000 0x1000>, <0x39000000 0x10000>;
+			reg-names = "nphys", "vphys";
+			clocks = <&gcc UBI32_CORE1_CLK>, <&gcc NSSTCM_CLK_SRC>,
+				<&gcc NSSTCM_CLK>, <&rpmcc RPM_NSS_FABRIC_0_CLK>,
+				<&rpmcc RPM_NSS_FABRIC_1_CLK>;
+			clock-names = "nss-core-clk", "nss-tcm-src", "nss-tcm-clk",
+				      "nss-fab0-clk", "nss-fab1-clk";
+			resets = <&gcc UBI32_CORE1_CLKRST_CLAMP_RESET>,
+				 <&gcc UBI32_CORE1_CLAMP_RESET>,
+				 <&gcc UBI32_CORE1_AHB_RESET>,
+				 <&gcc UBI32_CORE1_AXI_RESET>;
+			reset-names = "clkrst-clamp", "clamp", "ahb", "axi";
+			qcom,id = <0>;
+			qcom,num-irq = <2>;
+			qcom,num-queue = <2>;
+			qcom,load-addr = <0x40000000>;
+			qcom,turbo-frequency;
+			qcom,ipv4-enabled;
+			qcom,ipv6-enabled;
+			qcom,pppoe-enabled;
+			qcom,pptp-enabled;
+			qcom,vlan-enabled;
+			qcom,wlan-dataplane-offload-enabled;
+		};
+
+		nss1: nss@40800000 {
+			compatible = "qcom,nss";
+			qcom,low-frequency = <733000000>;
+			qcom,mid-frequency = <733000000>;
+			qcom,max-frequency = <733000000>;
+			interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0x36400000 0x1000>, <0x39010000 0x10000>;
+			reg-names = "nphys", "vphys";
+			resets = <&gcc UBI32_CORE2_CLKRST_CLAMP_RESET>,
+				 <&gcc UBI32_CORE2_CLAMP_RESET>,
+				 <&gcc UBI32_CORE2_AHB_RESET>,
+				 <&gcc UBI32_CORE2_AXI_RESET>;
+			reset-names = "clkrst-clamp", "clamp", "ahb", "axi";
+			qcom,id = <1>;
+			qcom,num-irq = <2>;
+			qcom,num-queue = <2>;
+			qcom,load-addr = <0x40800000>;
+			qcom,turbo-frequency;
+		};
-		};
--- a/arch/arm/boot/dts/qcom/qcom-ipq8064-wg2600hp.dts
+++ b/arch/arm/boot/dts/qcom/qcom-ipq8064-wg2600hp.dts
@@ -247,5 +247,17 @@
 &gmac1 {
 	status = "okay";
+	compatible = "qcom,nss-gmac";
 
 	phy-mode = "rgmii";
 	qcom,id = <1>;
+	qcom,pcs-chanid = <0>;
+	qcom,phy-mdio-addr = <4>;
+	qcom,poll-required = <0>;
+	qcom,rgmii-delay = <1>;
+	qcom,phy_mii_type = <0>;
+	qcom,emulation = <0>;
+	qcom,forced-speed = <1000>;
+	qcom,forced-duplex = <1>;
+	qcom,socver = <0>;
+	qcom,irq = <255>;
+	mdiobus = <&mdio0>;
@@ -265,5 +265,17 @@
 &gmac2 {
 	status = "okay";
+	compatible = "qcom,nss-gmac";
 
 	phy-mode = "sgmii";
 	qcom,id = <2>;
+	qcom,pcs-chanid = <1>;
+	qcom,phy-mdio-addr = <0>;
+	qcom,poll-required = <0>;
+	qcom,rgmii-delay = <0>;
+	qcom,phy_mii_type = <1>;
+	qcom,emulation = <0>;
+	qcom,forced-speed = <1000>;
+	qcom,forced-duplex = <1>;
+	qcom,socver = <0>;
+	qcom,irq = <258>;
+	mdiobus = <&mdio0>;
