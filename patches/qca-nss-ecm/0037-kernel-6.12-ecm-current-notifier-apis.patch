  *	When a MAC address is moved to another interface.
  *
  */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 12, 0)
 static int ecm_interface_node_br_fdb_notify_event(struct notifier_block *nb,
 					       unsigned long event,
 					       void *data)
@@ -7389,6 +7393,47 @@
 };
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+static int ecm_interface_switchdev_fdb_notify_event(struct notifier_block *nb,
+							unsigned long event,
+							void *data)
+{
+	struct switchdev_notifier_fdb_info *fdb = data;
+
+	if (event != SWITCHDEV_FDB_ADD_TO_BRIDGE &&
+	    event != SWITCHDEV_FDB_DEL_TO_BRIDGE)
+		return NOTIFY_DONE;
+	if (!fdb || !fdb->addr || fdb->is_local)
+		return NOTIFY_DONE;
+	ecm_interface_node_connections_defunct((uint8_t *)fdb->addr,
+			ECM_DB_IP_VERSION_IGNORE);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ecm_interface_switchdev_fdb_nb = {
+	.notifier_call = ecm_interface_switchdev_fdb_notify_event,
+};
+
+static int ecm_interface_netevent_notify_event(struct notifier_block *nb,
+							unsigned long event,
+							void *data)
+{
+	struct neighbour *neigh = data;
+
+	if (event != NETEVENT_NEIGH_UPDATE || !neigh ||
+	    neigh->nud_state == NUD_NOARP || neigh->ha[0] == 0)
+		return NOTIFY_DONE;
+	ecm_interface_node_connections_defunct(neigh->ha,
+			ECM_DB_IP_VERSION_IGNORE);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ecm_interface_netevent_nb = {
+	.notifier_call = ecm_interface_netevent_notify_event,
+};
+#endif
+#endif
